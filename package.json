{
  "name": "create-foxkit",
  "version": "0.1.7",
  "description": "TypeScript project generator and Firefox extension test harness with Puppeteer, Ichabod, GitHub Actions, and npm release workflows.",
  "type": "module",
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/foxkit.git"
  },
  "homepage": "https://github.com/pooriaarab/foxkit#readme",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "create-foxkit": "dist/cli.js"
  },
  "exports": {
    "./e2e": {
      "types": "./dist/e2e.d.ts",
      "default": "./dist/e2e.js"
    },
    "./fox": {
      "types": "./dist/fox.d.ts",
      "default": "./dist/fox.js"
    },
    "./fox.svg": "./fox/fox.svg",
    "./fox.css": "./fox/fox.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fox",
    "template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts",
    "test": "vitest run",
    "ci:local": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "e2e": "pnpm build && node scripts/e2e.mjs",
    "e2e:ichabod": "pnpm build && node scripts/e2e-ichabod.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "puppeteer-core": "^25.12.0"
  },
  "keywords": [
    "typescript",
    "project-generator",
    "firefox",
    "webextensions",
    "puppeteer",
    "ichabod",
    "cloudflare",
    "github-actions",
    "npm",
    "pnpm",
    "end-to-end-testing",
    "manifest-v3"
  ]
}
